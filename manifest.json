{
  "manifest_version": 3,
  "name": "LongTube",
  "version": "1.3.0",
  "description": "Hides YouTube Shorts and Playables from the homepage, sidebar, and search results for our own sanity.",
  "host_permissions": ["*://*.youtube.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "noshortsyt@aukmind.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
